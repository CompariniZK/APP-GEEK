# Copy this file to ".env" (same folder) and fill in the two values from
# Supabase → your project → Project Settings → API (or the "Connect" button).
# ".env" is git-ignored: it never goes to GitHub.
#
# Use the PUBLIC key ("anon" / "publishable"). NEVER put the "service_role" / "secret" key here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your-anon-or-publishable-key
